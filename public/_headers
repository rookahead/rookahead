# Cloudflare Pages response headers.
# Multi-threaded Stockfish needs SharedArrayBuffer, which browsers only expose
# on cross-origin isolated pages. These two headers turn isolation on.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Hashed bundles never change; engine files change only with a new Stockfish version.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/engine/*
  Cache-Control: public, max-age=604800
# The service worker is checked for updates on every visit.
/sw.js
  Cache-Control: no-cache
# Puzzle shards change only when the data is rebuilt.
/puzzle-data/*
  Cache-Control: public, max-age=86400

# The embed viewer runs inside other sites' iframes. Its own isolation headers don't stop
# ordinary pages from framing it; this also lets cross-origin isolated pages (and the app's
# own Share dialog preview) load it.
/embed*
  Cross-Origin-Resource-Policy: cross-origin
