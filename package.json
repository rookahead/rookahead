    "@fontsource/dm-mono": "^5.3.0",
    "@lichess-org/chessground": "^10.4.2",
    "@supabase/supabase-js": "^2.118.0",
    "chess.js": "^1.4.0",
    "gifenc": "^1.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stockfish": "^19.0.0"
  },
  "devDependencies": {
